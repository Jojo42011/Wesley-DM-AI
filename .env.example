# --- Required in production ---
ANTHROPIC_API_KEY=

# --- Zernio: the TikTok DM transport ---
# Zernio API key for Wesley's own Zernio profile. Prefer a restricted, messaging
# scoped key (zrk_...) over a full-access one. Never commit the value.
ZERNIO_DM_API_KEY=
# Shared secret for verifying X-Zernio-Signature, a lowercase hex HMAC-SHA256
# over the raw request body. We choose it and register the SAME value on the
# Zernio webhook. Unset closes the webhook with 503 rather than opening it.
ZERNIO_WEBHOOK_SECRET=
# Zernio account id for Wesley's TikTok. Every inbound event is checked against
# it and every send carries it. Unset matches NOTHING, so the server ignores
# traffic rather than answering another account's leads.
ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Access control ---
# Gates the dashboard, its APIs and /api/zernio/status. Unset returns 503, not
# an open dashboard. Does NOT gate /api/zernio/webhook, which uses its HMAC.
DASHBOARD_TOKEN=
# DASHBOARD_PUBLIC=1 opens the Lead Desk on the bare URL with no token. Read
# surface only: the simulator and /api/zernio/status stay behind the token, and
# contact details are redacted out of transcripts while it is on.
DASHBOARD_PUBLIC=
# Opens the ManyChat-shaped testing simulator at POST /webhook/tiktok. A
# dashboard session also opens it; without either it is closed.
TESTING_WEBHOOK_SECRET=

# --- Optional ---
# SQLite database file (default ./data/wesley.db; /data/wesley.db on Fly)
SQLITE_PATH=
# Low-latency conversation model (default: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5
# Where the server listens (default 3000)
PORT=3000
# CRM / Zapier / Make webhook that receives captured leads
HANDOFF_WEBHOOK_URL=
# Path to approved voice examples JSON (default ./data/voice-examples.json)
VOICE_EXAMPLES_PATH=
# Rapid-message batching window in ms (default 4000). Lower it only for tests.
ZERNIO_DEBOUNCE_MS=
# Zernio API base (default https://zernio.com/api/v1). Override only for tests.
ZERNIO_API_BASE=
# Seed demo data so the dashboard is reviewable before launch (dev only)
DEMO_MODE=0
# STORE=memory forces the ephemeral in-memory store (tests/dev only)
STORE=

# --- TikTok comment agent (public replies that invite a DM) ---
# Same Zernio key/account as DMs. Kill switch: set to false to stop public posts.
COMMENT_AGENT_ENABLED=true
# Pacing (defaults match Marco's live caps)
COMMENT_AGENT_MAX_PER_HOUR=12
COMMENT_AGENT_MAX_PER_DAY=60
COMMENT_AGENT_MIN_SPACING_SEC=25
COMMENT_AGENT_MAX_COMMENT_AGE_HOURS=48
# SQLite ledger (default /data/comment-agent.db on Fly, ./data/comment-agent.db locally)
COMMENT_AGENT_DB_PATH=
