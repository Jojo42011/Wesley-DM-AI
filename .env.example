# --- Required in production ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ---
# SQLite database file (default ./data/wesley.db; /data/wesley.db on Fly)
SQLITE_PATH=
# Low-latency conversation model (default: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5
# Where the server listens (default 3000)
PORT=3000
# CRM / Zapier / Make webhook that receives captured leads
HANDOFF_WEBHOOK_URL=
# Path to approved voice examples JSON (default ./data/voice-examples.json)
VOICE_EXAMPLES_PATH=
# Seed demo data so the dashboard is reviewable before launch (dev only)
DEMO_MODE=0
# STORE=memory forces the ephemeral in-memory store (tests/dev only)
STORE=
